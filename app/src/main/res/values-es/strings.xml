    <!-- Guide -->
    <string name="settings_guide">Guía de la app</string>
    <string name="guide_heading">Cómo funciona StepUp</string>
    <string name="guide_skip">Saltar</string>
    <string name="guide_next">Siguiente</string>
    <string name="guide_start">Empezar con StepUp</string>
    <string name="guide1_title">Inicio de un vistazo</string>
    <string name="guide1_body">Tus pasos, energía y zapatilla equipada en una sola pantalla. El panel convierte tu distancia en monumentos famosos.</string>
    <string name="guide1_tip">Consejo: pulsa START RUN para empezar a ganar.</string>
    <string name="guide2_title">Corre y gana SUP</string>
    <string name="guide2_body">Durante una carrera, cada paso gana SUP mientras quede energía. La energía se recarga a medianoche.</string>
    <string name="guide2_tip">Consejo: el impulso de tu zapatilla multiplica lo ganado.</string>
    <string name="guide3_title">Colecciona zapatillas NFT</string>
    <string name="guide3_body">Cuatro facciones y 44 huecos de álbum. Mintea con SUP, mejora niveles y equipa tu par favorito.</string>
    <string name="guide3_tip" formatted="false">Consejo: los impulsos son pequeños, ¡colecciona por el diseño!</string>
    <string name="guide4_title">Foro de la comunidad</string>
    <string name="guide4_body">Únete a quedadas ordenadas por cercanía y comparte consejos. La tarjeta de ranking muestra tu posición semanal.</string>
    <string name="guide4_tip">Consejo: el botón + crea una publicación.</string>
    <string name="guide5_title">Crews y carreras en grupo</string>
    <string name="guide5_body" formatted="false">Únete o crea un crew y abre el lobby. Cuando todos estén listos, el líder inicia: cada miembro suma +10%.</string>
    <string name="guide5_tip">Consejo: ¡no te alejes más de 100 m del líder!</string>
    <string name="guide6_title">Eventos y recompensas</string>
    <string name="guide6_body">Las campañas semanales y las invitaciones pagan SUP real. Reclama recompensas desde las notificaciones.</string>
    <string name="guide6_tip">Consejo: mira la pestaña de eventos.</string>
    <string name="guide7_title">Perfil y logros</string>
    <string name="guide7_body">Elige avatar, guarda tu ID de corredor y persigue 100 logros de Bronce a Diamante: un año constante los desbloquea todos.</string>
    <string name="guide7_tip">Consejo: reabre esta guía desde tu perfil.</string>
