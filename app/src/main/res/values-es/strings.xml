    <!-- Seed posts -->
    <string name="seed_flash1_title">5K nocturnos junto al río, ¿alguien?</string>
    <string name="seed_flash1_body">Ritmo suave de 6:00/km. Si es tu primera vez, mejor todavía.</string>
    <string name="seed_flash2_title">Carrera matutina antes del trabajo</string>
    <string name="seed_flash2_body">Salimos a las 6:30 y terminamos en 40 minutos exactos.</string>
    <string name="seed_flash3_title">Busco compañero para series</string>
    <string name="seed_flash3_body">400 m × 8. Mejor aún si puedes aguantar el ritmo conmigo.</string>
    <string name="seed_flash4_title">Tirada larga del finde, 20K</string>
    <string name="seed_flash4_body">Despacio y largo. Paramos dos veces a por avituallamiento.</string>
    <string name="seed_free1_title">Por fin he hecho una media maratón</string>
    <string name="seed_free1_body">Hace seis meses 3K me destrozaban. Hoy he acabado en 1:58. La constancia lo es todo.</string>
    <string name="seed_free2_title">¿Qué hacéis los días de lluvia?</string>
    <string name="seed_free2_body">La cinta me aburre muchísimo. ¿Tenéis alguna rutina de interior que funcione?</string>
    <string name="seed_free3_title">Acabo de pasar de 1.000 SUP</string>
    <string name="seed_free3_body">Solo yendo al trabajo andando. Se acumula más rápido de lo que pensaba.</string>
    <string name="seed_tip1_title">Truco de energía: no la gastes toda por la mañana</string>
    <string name="seed_tip1_body">La energía se recarga a medianoche: si corres por la tarde, gasta solo la mitad temprano y ganarás más en total.</string>
    <string name="seed_tip2_title">Mintea con el par de más suerte</string>
    <string name="seed_tip2_body">La suerte de tus zapatillas equipadas influye directamente en las rarezas altas. Cámbiatelas justo antes de mintear.</string>
    <string name="seed_tip3_title">Las carreras en grupo compensan desde cuatro personas</string>
    <string name="seed_tip3_body">El impulso crece con el número de gente, así que gana de largo a correr solo. Todos deben pulsar «listo» en el lobby.</string>
    <string name="seed_crew1_title">Fijemos el objetivo del crew para esta semana</string>
    <string name="seed_crew1_body">La semana pasada hicimos 32 km de media. ¿Vamos a por 35?</string>
    <string name="seed_crew2_title">He actualizado el mapa de nuestra ruta</string>
    <string name="seed_crew2_body">He añadido un desvío en el tramo 3 por las obras del puente. Míralo antes de la próxima quedada.</string>
    <string name="seed_crew3_title">Salida del crew esta noche</string>
    <string name="seed_crew3_body">Salimos a las 8:00 en punto. ¡Alcanzarnos después cuesta!</string>

