    <!-- Support -->
    <string name="support_faq">FAQ</string>
    <string name="faq_q_earn">How do I earn SUP?</string>
    <string name="faq_a_earn">Start a run from the home screen. Steps counted during an active session earn SUP, scaled by your sneaker and any boosts.</string>
    <string name="faq_q_energy">Why did earning stop?</string>
    <string name="faq_a_energy">Energy ran out. One energy covers 600 steps and it refills to full every midnight.</string>
    <string name="faq_q_rarity">How does rarity work?</string>
    <string name="faq_a_rarity">Rarity sets the stat ceiling and max level. Higher Luck on your equipped pair improves your odds when minting.</string>
    <string name="faq_q_withdraw">When can I withdraw?</string>
    <string name="faq_a_withdraw">On-chain transfer to GIWA Chain is still in development. Your balance is safe until then.</string>
    <string name="support_contact">Contact</string>
    <string name="support_contact_body">Questions or bug reports are welcome through the project repository.</string>

